# Copy to .env.local (never commit it) and fill in. Set the same vars in Vercel:
# Project > Settings > Environment Variables.

# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "beauty photobooth <foto@beauty.co.id>".
# Without a verified domain, "onboarding@resend.dev" only delivers to your own Resend account email.
EMAIL_FROM=

# Cloudinary: Console > Settings > API Keys (the secret stays on the server)
CLOUDINARY_CLOUD_NAME=dzz98ilgz
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
